# ==========================================================
# FitGuard — Конфигурация для самостоятельного развёртывания
# Скопируйте этот файл в .env и заполните значения
# ==========================================================

# Сервер
PORT=3000
NODE_ENV=production

# База данных (MySQL / MariaDB). При развёртывании через docker-compose
# хост базы — "db", а не "localhost"
DATABASE_URL=mysql://fitguard:fitguard123@127.0.0.1:3306/fitguard
DB_PASSWORD=fitguard123
DB_ROOT_PASSWORD=fitguard_root_123

# Секрет для подписи сессий (минимум 32 случайных символа)
# Сгенерировать: openssl rand -base64 32
JWT_SECRET=change-this-secret-in-production-min32chars

# ==========================================================
# ИИ-модуль (ВСЕ ОПЦИИ НИЖЕ — БЕСПЛАТНЫЕ)
# ==========================================================
# FitGuard работает ДАЖЕ БЕЗ ИИ-ключа: встроенный детерминированный
# движок рассчитывает все метрики, дельты и риски без интернета.
# ИИ-модель обогащает отчёты живым экспертным текстом на русском языке.

# По умолчанию внешняя модель не подключена: оставьте эти строки пустыми,
# если нужен только встроенный детерминированный анализ.
#
# Вариант 1 (опционально): Groq — 100% бесплатно, Llama 3.3 70B, мгновенные ответы
# Ключ бесплатно: https://console.groq.com
# AI_PROVIDER=groq
# AI_MODEL=llama-3.3-70b-versatile
# AI_API_KEY=gsk_your_groq_api_key_here

# Вариант 2: OpenRouter — бесплатные модели (meta-llama/llama-3.3-70b-instruct:free)
# Ключ бесплатно: https://openrouter.ai
# AI_PROVIDER=openrouter
# AI_MODEL=meta-llama/llama-3.3-70b-instruct:free
# AI_API_KEY=sk-or-your_openrouter_api_key

# Вариант 3: Google Gemini — щедрый бесплатный тариф Gemini 2.5 Flash
# Ключ бесплатно: https://aistudio.google.com
# AI_PROVIDER=gemini
# AI_MODEL=gemini-2.5-flash
# AI_API_KEY=AIzaSy_your_gemini_api_key

# Вариант 4: Локальная Ollama — работает оффлайн на вашем компьютере/сервере
# Установка: https://ollama.com → `ollama run llama3.2`
# AI_PROVIDER=ollama
# AI_MODEL=llama3.2
# AI_API_BASE=http://localhost:11434/v1

# Вариант 5: режим без внешнего AI API (значения можно оставить пустыми)
# AI_PROVIDER=
# AI_MODEL=
# AI_API_KEY=

# ==========================================================
# Демо-данные (по желанию)
# ==========================================================
# Для загрузки тестовых учеников и тренера с историей тренировок:
#   npx tsx server/seed.ts
